# Provider Reference API — the mock external credentialing service
# (src/generators/provider_api.py), deployed as a standalone backend.
FROM python:3.11.9-slim-bookworm

RUN useradd --create-home appuser && mkdir -p /app/data/raw && chown -R appuser /app
USER appuser
WORKDIR /app
ENV PATH="/home/appuser/.local/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    FLASK_HOST=0.0.0.0 \
    FLASK_PORT=5000

COPY --chown=appuser docker/requirements-provider.txt .
RUN pip install --no-cache-dir --user -r requirements-provider.txt

COPY --chown=appuser src /app/src

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if b'ok' in urllib.request.urlopen('http://localhost:5000/health').read() else 1)"

CMD ["python", "-m", "src.generators.provider_api"]
